{
  "repetitions": 5,
  "warmups": 1,
  "timeout_seconds": 900,
  "sample_interval_ms": 50,
  "adaptive_repetitions": {
    "enabled": true,
    "pilot_repetitions": 2,
    "fast_seconds": 10,
    "slow_seconds": 60,
    "fast_repetitions": 5,
    "medium_repetitions": 3,
    "slow_repetitions": 2
  },
  "tools": [
    {
      "name": "graphite-bandage",
      "command": [
        "./target/release/graphite",
        "--benchmark",
        "--layout-backend",
        "bandage",
        "--benchmark-steps",
        "0",
        "--benchmark-output",
        "{output}",
        "{input}"
      ],
      "parse_json": true,
      "env": {
        "RAYON_NUM_THREADS": "8"
      }
    },
    {
      "name": "graphite-rust",
      "command": [
        "./target/release/graphite",
        "--benchmark",
        "--layout-backend",
        "rust",
        "--benchmark-steps",
        "0",
        "--benchmark-output",
        "{output}",
        "{input}"
      ],
      "parse_json": true,
      "env": {
        "RAYON_NUM_THREADS": "8"
      }
    },
    {
      "name": "bandage",
      "command": [
        "Bandage",
        "image",
        "{input}",
        "{output}"
      ],
      "version_command": [
        "Bandage",
        "--version"
      ]
    },
    {
      "name": "bandage-ng",
      "command": [
        "BandageNG",
        "image",
        "{input}",
        "{output}"
      ],
      "version_command": [
        "BandageNG",
        "--version"
      ]
    }
  ],
  "datasets": [
    {
      "name": "replace_with_real_assembly",
      "path": "/absolute/path/to/assembly.gfa",
      "kind": "real"
    }
  ],
  "dataset_manifests": [
    "benchmarks/data/manifest.json"
  ]
}
